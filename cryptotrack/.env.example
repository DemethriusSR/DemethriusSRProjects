# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e
# preencha os valores antes de rodar `docker-compose up`.
# O compose lê este .env automaticamente para o ${JWT_SECRET} etc.

# Gere com: openssl rand -hex 64
JWT_SECRET=

# Credenciais do usuário administrador criado no primeiro boot
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=

# URL pública do frontend (usada para restringir o CORS no backend)
FRONTEND_URL=http://localhost:3000

# true exige HTTPS (reverse proxy com TLS). Sem HTTPS configurado ainda,
# mantenha false — caso contrário o navegador descarta o cookie de login.
COOKIE_SECURE=false
